<org.eventb.core.machineFile org.eventb.core.comment="****************************************************************************&#10; * Add a separation between the environment and the controller.&#10; *&#10; *          il_tl             ml_tl&#10; *          &lt;- IL_in          &lt;- ML_out&#10; *  --------                    ----------&#10; * | Island |  One-way bridge  | Mainland |&#10; *  --------                    ----------&#10; *          -&gt; IL_out         -&gt; ML_in&#10; * ==========================================================================&#10; *        b          &lt;-a, c-&gt;&#10; *              |                     |&#10; *              |---------------------|&#10; *              |IL_IN sensor         |ML_OUT sensor&#10; *              |                     |&#10; *       Island |      Bridge         | Mainland&#10; * &#9;&#9;        |                     |&#10; * IL_OUT sensor|         ML_IN sensor|&#10; *              |---------------------|&#10; *              |                     |&#10; * ==========================================================================&#10; *   il_out_10   --------------------&#10; *    ---------&gt;|     CONTROLLER     |&#10; *   |il_in_10  |                    |il_tl&#10; *   |  -------&gt;|                    |--------&#10; *   | |ml_in_10|                    |        |&#10; *   | |  -----&gt;|       a b c        |-----   |&#10; *   | | |      |                    |     |  |&#10; *   | | |  ---&gt;|  ml_pass il_pass   |     |  |&#10; *   | | | |     --------------------      |  |&#10; *   | | | |ml_out_10               ml_tl  |  |&#10; *   | | | |     --------------------      |  |&#10; *   | | |  ----|      ENVIRONMENT   |     |  |&#10; *   | | |      |                    |     |  |&#10; *   | |  ------|        A B C       |&lt;----   |&#10; *   | |        |                    |        |&#10; *   |  --------| ML_OUT_SR ML_IN_SR |&lt;-------&#10; *   |          |                    |&#10; *    ----------| IL_OUT_SR IL_IN_SR |&#10; *               --------------------&#10; * ****************************************************************************" org.eventb.core.configuration="org.eventb.core.fwd" org.eventb.core.generated="false" org.eventb.texttools.text_lastmodified="1780688289842" org.eventb.texttools.text_representation="machine C3&#10;/*****************************************************************************&#10; * Add a separation between the environment and the controller.&#10; *&#10; *          il_tl             ml_tl&#10; *          &lt;- IL_in          &lt;- ML_out&#10; *  --------                    ----------&#10; * | Island |  One-way bridge  | Mainland |&#10; *  --------                    ----------&#10; *          -&gt; IL_out         -&gt; ML_in&#10; * ==========================================================================&#10; *        b          &lt;-a, c-&gt;&#10; *              |                     |&#10; *              |---------------------|&#10; *              |IL_IN sensor         |ML_OUT sensor&#10; *              |                     |&#10; *       Island |      Bridge         | Mainland&#10; * &#9;&#9;        |                     |&#10; * IL_OUT sensor|         ML_IN sensor|&#10; *              |---------------------|&#10; *              |                     |&#10; * ==========================================================================&#10; *   il_out_10   --------------------&#10; *    ---------&gt;|     CONTROLLER     |&#10; *   |il_in_10  |                    |il_tl&#10; *   |  -------&gt;|                    |--------&#10; *   | |ml_in_10|                    |        |&#10; *   | |  -----&gt;|       a b c        |-----   |&#10; *   | | |      |                    |     |  |&#10; *   | | |  ---&gt;|  ml_pass il_pass   |     |  |&#10; *   | | | |     --------------------      |  |&#10; *   | | | |ml_out_10               ml_tl  |  |&#10; *   | | | |     --------------------      |  |&#10; *   | | |  ----|      ENVIRONMENT   |     |  |&#10; *   | | |      |                    |     |  |&#10; *   | |  ------|        A B C       |&lt;----   |&#10; *   | |        |                    |        |&#10; *   |  --------| ML_OUT_SR ML_IN_SR |&lt;-------&#10; *   |          |                    |&#10; *    ----------| IL_OUT_SR IL_IN_SR |&#10; *               --------------------&#10; * *****************************************************************************/&#10; refines C2  sees C3Ctx&#10;&#10;variables a // Number of cars on the bridge and going to the island.&#10;          b // Number of cars on the island.&#10;          c // Number of cars on the bridge and going to the mainland.&#10;          il_tl // Island's traffic light.&#10;          ml_tl // Mainland's traffic light&#10;          ml_pass // True iff at least one car has passed since ml tl is green.&#10;          il_pass // True iff at least one car has passed since il tl is green.&#10;          ml_in_10 // True iff mainland in sensor goes from &quot;on&quot; to &quot;off&quot;.&#10;          ml_out_10 // True iff mainland out sensor goes from &quot;on&quot; to &quot;off&quot;.&#10;          il_in_10 // True iff island in sensor goes from &quot;on&quot; to &quot;off&quot;.&#10;          il_out_10&#10;          /* True iff island out sensor goes from &quot;on&quot; to &quot;off&quot;&#10;             The previous variables are the input channel variables, i.e.&#10;             from environment to controller. */&#10;          A // Physical number of cars on bridge towards island&#10;          B // Physical number of cars on island&#10;          C // Physical number of cars on bridge towards mainland&#10;          ML_IN_SR // Physical mainland in sensor.&#10;          ML_OUT_SR // Physical mainland out sensor.&#10;          IL_IN_SR // Physical island in sensor.&#10;          IL_OUT_SR&#10;          /* Physical island out sensor.&#10;             The previous variables are physical variables, i.e.&#10;             describing the environment. */&#10;&#10;&#10;invariants&#10;  @i0 ML_OUT_SR ∈ SENSOR&#10;  @i1 ML_IN_SR  ∈ SENSOR&#10;  @i2 IL_OUT_SR ∈ SENSOR&#10;  @i3 IL_IN_SR  ∈ SENSOR&#10;  @i4 A         ∈ ℕ&#10;  @i5 B         ∈ ℕ&#10;  @i6 C         ∈ ℕ&#10;  @i7 ml_out_10 ∈ BOOL&#10;  @i8 ml_in_10  ∈ BOOL&#10;  @i9 il_out_10 ∈ BOOL&#10;  @i10 il_in_10  ∈ BOOL&#10;  @i11 IL_IN_SR  = on ⇒ A &gt; 0&#10;  @i12 IL_OUT_SR = on ⇒ B &gt; 0&#10;  @i13 ML_IN_SR  = on ⇒ C &gt; 0&#10;  @i14 ml_out_10 = TRUE ⇒ ml_tl = green&#10;  @i15 il_out_10 = TRUE ⇒ il_tl = green&#10;  @i16 IL_IN_SR  = on ⇒ il_in_10  = FALSE&#10;  @i17 IL_OUT_SR = on ⇒ il_out_10 = FALSE&#10;  @i18 ML_IN_SR  = on ⇒ ml_in_10  = FALSE&#10;  @i19 ML_OUT_SR = on ⇒ ml_out_10 = FALSE&#10;  @i20 il_in_10  = TRUE  ∧ ml_out_10 = TRUE  ⇒ A = a&#10;  @i21 il_in_10  = FALSE ∧ ml_out_10 = TRUE  ⇒ A = a + 1&#10;  @i22 il_in_10  = TRUE  ∧ ml_out_10 = FALSE ⇒ A = a − 1&#10;  @i23 il_in_10  = FALSE ∧ ml_out_10 = FALSE ⇒ A = a&#10;  @i24 il_in_10  = TRUE  ∧ il_out_10 = TRUE  ⇒ B = b&#10;  @i25 il_in_10  = TRUE  ∧ il_out_10 = FALSE ⇒ B = b + 1&#10;  @i26 il_in_10  = FALSE ∧ il_out_10 = TRUE  ⇒ B = b − 1&#10;  @i27 il_in_10  = FALSE ∧ il_out_10 = FALSE ⇒ B = b&#10;  @i28 il_out_10 = TRUE  ∧ ml_in_10  = TRUE  ⇒ C = c&#10;  @i29 il_out_10 = TRUE  ∧ ml_in_10  = FALSE ⇒ C = c + 1&#10;  @i30 il_out_10 = FALSE ∧ ml_in_10  = TRUE  ⇒ C = c − 1&#10;  @i31 il_out_10 = FALSE ∧ ml_in_10  = FALSE ⇒ C = c&#10;  @i32 A = 0 ∨ C = 0&#10;  @i33 A+B+C ≤ d&#10;  theorem @dlf (ml_out_10 = TRUE ∧ a+b+1 ≠ d)&#10;               ∨ (ml_out_10 = TRUE ∧ a+b+1 = d)&#10;               ∨ (il_out_10 = TRUE ∧ b ≠ 1)&#10;               ∨ (il_out_10 = TRUE ∧ b = 1)&#10;               ∨ (ml_in_10 = TRUE ∧ c &gt; 0)&#10;               ∨ (il_in_10 = TRUE ∧ a &gt; 0)&#10;               ∨ (ml_tl = red ∧ a+b &lt; d ∧ c = 0 ∧ il_pass = TRUE ∧ il_out_10 = FALSE)&#10;               ∨ (il_tl = red ∧ 0 &lt; b ∧ a = 0 ∧ ml_pass = TRUE ∧ ml_out_10 = FALSE)&#10;               ∨ (ML_OUT_SR = off ∧ ml_out_10 = FALSE)&#10;               ∨ (ML_IN_SR = off ∧ ml_in_10 = FALSE ∧ C &gt; 0)&#10;               ∨ (IL_IN_SR = off ∧ il_in_10 = FALSE ∧ A &gt; 0)&#10;               ∨ (IL_OUT_SR = off ∧ il_out_10 = FALSE ∧ B &gt; 0)&#10;               ∨ (ML_OUT_SR = on ∧ ml_tl = green ∧ C = 0 ∧ A+B+C &lt; d)&#10;               ∨ ML_IN_SR = on&#10;               ∨ IL_IN_SR = on&#10;               ∨ (IL_OUT_SR = on ∧ il_tl = green ∧ A = 0)&#10;&#10;variant 12 − (s2n(ML_OUT_SR) + s2n(ML_IN_SR) + s2n(IL_OUT_SR) + s2n(IL_IN_SR) +&#10;        2 ∗ (b2n(ml_out_10) + b2n(ml_in_10) + b2n(il_out_10) + b2n(il_in_10)))&#10;&#10;events&#10;  event INITIALISATION extends INITIALISATION&#10;    then&#10;      @a7 ml_in_10  ≔ FALSE&#10;      @a8 ml_out_10 ≔ FALSE&#10;      @a9 il_in_10  ≔ FALSE&#10;      @a10 il_out_10 ≔ FALSE&#10;      @a11 A         ≔ 0 // env&#10;      @a12 B         ≔ 0 // env&#10;      @a13 C         ≔ 0 // env&#10;      @a14 ML_IN_SR  ≔ off // env&#10;      @a15 ML_OUT_SR ≔ off // env&#10;      @a16 IL_IN_SR  ≔ off // env&#10;      @a17 IL_OUT_SR ≔ off // env&#10;  end&#10;&#10;  event ML_out_1 refines ML_out_1&#10;    where&#10;      @g0 ml_out_10 = TRUE&#10;      @g1 a+b+1 ≠ d&#10;    then&#10;      @a0 a ≔ a+1&#10;      @a1 ml_pass ≔ TRUE&#10;      @a2 ml_out_10 ≔ FALSE&#10;  end&#10;&#10;  event ML_out_2 refines ML_out_2&#10;    where&#10;      @g0 ml_out_10 = TRUE&#10;      @g1 a+b+1 = d&#10;    then&#10;      @a0 a ≔ a+1&#10;      @a1 ml_tl ≔ red&#10;      @a2 ml_pass ≔ TRUE&#10;      @a3 ml_out_10 ≔ FALSE&#10;  end&#10;&#10;  event IL_out_1 refines IL_out_1&#10;    where&#10;      @g0 il_out_10 = TRUE&#10;      @g1 b ≠ 1&#10;    then&#10;      @a0 b ≔ b−1&#10;      @a1 c ≔ c+1&#10;      @a2 il_pass ≔ TRUE&#10;      @a3 il_out_10 ≔ FALSE&#10;  end&#10;&#10;  event IL_out_2 refines IL_out_2&#10;    where&#10;      @g0 il_out_10 = TRUE&#10;      @g1 b = 1&#10;    then&#10;      @a0 b ≔ b−1&#10;      @a1 c ≔ c+1&#10;      @a2 il_tl ≔ red&#10;      @a3 il_pass ≔ TRUE&#10;      @a4 il_out_10 ≔ FALSE&#10;  end&#10;&#10;  event ML_in refines ML_in&#10;    where&#10;      @g0 ml_in_10 = TRUE&#10;      @g1 c &gt; 0&#10;    then&#10;      @a0 c ≔ c−1&#10;      @a1 ml_in_10 ≔ FALSE&#10;  end&#10;&#10;  event IL_in refines IL_in&#10;    where&#10;      @g0 il_in_10 = TRUE&#10;      @g1 a &gt; 0&#10;    then&#10;      @a0 a ≔ a−1&#10;      @a1 b ≔ b+1&#10;      @a2 il_in_10 ≔ FALSE&#10;  end&#10;&#10;  event ML_tl_green refines ML_tl_green&#10;    where&#10;      @g0 ml_tl = red&#10;      @g1 a+b &lt; d&#10;      @g2 c = 0&#10;      @g3 il_pass = TRUE&#10;      @g4 il_out_10 = FALSE&#10;    then&#10;      @a0 ml_tl ≔ green&#10;      @a1 il_tl ≔ red&#10;      @a2 ml_pass ≔ FALSE&#10;  end&#10;&#10;  event IL_tl_green refines IL_tl_green&#10;    where&#10;      @g0 il_tl = red&#10;      @g1 0 &lt; b&#10;      @g2 a = 0&#10;      @g3 ml_pass = TRUE&#10;      @g4 ml_out_10 = FALSE&#10;    then&#10;      @a0 il_tl ≔ green&#10;      @a1 ml_tl ≔ red&#10;      @a2 il_pass ≔ FALSE&#10;  end&#10;&#10;  event ML_out_arr // A car arrives on the ML_out sensor.&#10;    where&#10;      @g0 ML_OUT_SR = off&#10;      @g1 ml_out_10 = FALSE&#10;    then&#10;      @a0 ML_OUT_SR ≔ on&#10;  end&#10;&#10;  event ML_in_arr // A car arrives on the ML_in sensor.&#10;    where&#10;      @g0 ML_IN_SR = off&#10;      @g1 ml_in_10 = FALSE&#10;      @g2 C &gt; 0&#10;    then&#10;      @a0 ML_IN_SR ≔ on&#10;  end&#10;&#10;  event IL_in_arr // A car arrives on the IL_in sensor.&#10;    where&#10;      @g0 IL_IN_SR = off&#10;      @g1 il_in_10 = FALSE&#10;      @g2 A &gt; 0&#10;    then&#10;      @a0 IL_IN_SR ≔ on&#10;  end&#10;&#10;  convergent event IL_out_arr // A car arrives on the IL_out sensor.&#10;    where&#10;      @g0 IL_OUT_SR = off&#10;      @g1 il_out_10 = FALSE&#10;      @g2 B &gt; 0&#10;    then&#10;      @a0 IL_OUT_SR ≔ on&#10;  end&#10;&#10;  convergent event ML_out_dep // A car leaves the ML_out sensor.&#10;    where&#10;      @g0 ML_OUT_SR = on&#10;      @g1 ml_tl = green&#10;      @g2 C = 0&#10;      @g3 A+B+C &lt; d&#10;    then&#10;      @a0 ML_OUT_SR ≔ off&#10;      @a1 ml_out_10 ≔ TRUE&#10;      @a2 A ≔ A+1&#10;  end&#10;&#10;  convergent event ML_in_dep // A car leaves the ML_in sensor.&#10;    where&#10;      @g0 ML_IN_SR = on&#10;    then&#10;      @a0 ML_IN_SR ≔ off&#10;      @a1 ml_in_10 ≔ TRUE&#10;      @a2 C ≔ C−1&#10;  end&#10;&#10;  event IL_in_dep // A car leaves the IL_in sensor.&#10;    where&#10;      @g0 IL_IN_SR = on&#10;    then&#10;      @a0 IL_IN_SR ≔ off&#10;      @a1 il_in_10 ≔ TRUE&#10;      @a2 A ≔ A−1&#10;      @a3 B ≔ B+1&#10;  end&#10;&#10;  convergent event IL_out_dep // A car leaves the IL_out sensor.&#10;    where&#10;      @g0 IL_OUT_SR = on&#10;      @g1 il_tl = green&#10;      @g2 A = 0&#10;    then&#10;      @a0 IL_OUT_SR ≔ off&#10;      @a1 il_out_10 ≔ TRUE&#10;      @a2 B ≔ B−1&#10;      @a3 C ≔ C+1&#10;  end&#10;end&#10;" version="5">

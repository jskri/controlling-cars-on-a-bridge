<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.comment="*************************************************************************&#10; * Second model of course 02: Controlling cars on a bridge&#10; *&#10; * Introducing the bridge.&#10; *&#10; * See https://web-archive.southampton.ac.uk/deploy-eprints.ecs.soton.ac.uk/112/1/sld.ch2.car.pdf&#10; *&#10; *              IL_in                       ML_out&#10; *  ---------   &lt;-----   ----------------   &lt;-----   ----------&#10; * | Island  |          | One Way Bridge |          | MainLand |&#10; *  ---------   -----&gt;   ----------------   -----&gt;   ----------&#10; *              IL_out                       ML_in&#10; * ************************************************************************* " org.eventb.core.configuration="org.eventb.core.fwd" org.eventb.core.generated="false" org.eventb.texttools.text_lastmodified="1780688698422" org.eventb.texttools.text_representation="machine C1&#10;/* *************************************************************************&#10; * Second model of course 02: Controlling cars on a bridge&#10; *&#10; * Introducing the bridge.&#10; *&#10; * See https://web-archive.southampton.ac.uk/deploy-eprints.ecs.soton.ac.uk/112/1/sld.ch2.car.pdf&#10; *&#10; *              IL_in                       ML_out&#10; *  ---------   &lt;-----   ----------------   &lt;-----   ----------&#10; * | Island  |          | One Way Bridge |          | MainLand |&#10; *  ---------   -----&gt;   ----------------   -----&gt;   ----------&#10; *              IL_out                       ML_in&#10; * ************************************************************************* */&#10; refines C0  sees C0Ctx&#10;&#10;variables a // Number of cars on the bridge going to the island.&#10;          b // Number of cars on the island.&#10;          c // Number of cars on the bridge going to the mainland.&#10;&#10;&#10;invariants&#10;  @i0 a ∈ ℕ&#10;  @i1 b ∈ ℕ&#10;  @i2 c ∈ ℕ&#10;  @i3 n = a+b+c&#10;  @i4 a = 0 ∨ c = 0&#10;  /* One-way bridge.&#10;     From C0:&#10;     a+b+c ≤ d&#10;     a+b+c &gt; 0 ∨ a+b+c &lt; d */&#10;  theorem @dlf (c &gt; 0)&#10;               ∨ (a+b+c &lt; d ∧ c = 0)&#10;               ∨ (a &gt; 0)&#10;               ∨ (a = 0 ∧ b &gt; 0)&#10;  /* Disjunction of all event guards.&#10;   * `(n &gt; 0 ∨ n &lt; d) ⇒ ` is removed because it is already proved in&#10;   * the first model (C0).&#10;   * Informal proof:&#10;   * - We know the bridge is one-way (a = 0 ∨ c = 0).&#10;   * - Suppose no car on the bridge to the island (a = 0).&#10;   *   - Suppose cars on the island (b &gt; 0) -&gt; IL_out possible.&#10;   *   - Suppose no car on the island (b = 0).&#10;   *     - Suppose cars on bridge to the mainland (c &gt; 0) -&gt; ML_in possible.&#10;   *     - Suppose no car on bridge to the mainland (c = 0) -&gt; ML_out possible.&#10;   * - Suppose no car on the bridge to the mainland (c = 0).&#10;   *   - Suppose cars on bridge to island (a &gt; 0) -&gt; IL_in possible&#10;   *   - Suppose no car on bridge to island (a = 0).&#10;   *     - Suppose cars on island (b &gt; 0) -&gt; IL_out possible&#10;   *     - Suppose no car on island (b = 0) -&gt; ML_out possible */&#10;&#10;variant 2∗a + b&#10;&#10;events&#10;  event INITIALISATION&#10;    then&#10;      @a0 a ≔ 0&#10;      @a1 b ≔ 0&#10;      @a2 c ≔ 0&#10;  end&#10;&#10;  event ML_in // One car on the bridge enters the mainland.&#10;  refines ML_in&#10;    where&#10;      @g0 c &gt; 0&#10;    then&#10;      @a0 c ≔ c−1&#10;  end&#10;&#10;  event ML_out // One car from the mainland enters the bridge.&#10;  refines ML_out&#10;    where&#10;      @g0 a+b+c &lt; d // Max cars not reached on island + bridge.&#10;      @g1 c = 0 // No car on the bridge going to the mainland.&#10;    then&#10;      @a0 a ≔ a+1&#10;  end&#10;&#10;  convergent event IL_in&#10;  /* One car on the bridge enters the island.&#10;     No car count check here because it is done when leaving the mainland.&#10;     variant' = 2(a-1) + (b+1)&#10;     = (2a + -2) + (b+1)&#10;     = 2a + b - 1&#10;     &lt; 2a + b */&#10;    where&#10;      @g0 a &gt; 0 // At least one incoming car on the bridge.&#10;    then&#10;      @a0 a ≔ a−1&#10;      @a1 b ≔ b+1&#10;  end&#10;&#10;  convergent event IL_out&#10;  /* One car on the island enters the bridge.&#10;     variant' = 2a + b-1&#10;     &lt; 2a + b */&#10;    where&#10;      @g0 a = 0 // No incoming car on the bridge.&#10;      @g1 b &gt; 0 // Some cars on the island.&#10;    then&#10;      @a0 b ≔ b−1&#10;      @a1 c ≔ c+1&#10;  end&#10;end&#10;" version="5">
    <org.eventb.core.refinesMachine name="_bljuAGAuEfGStvY_HyjkDQ" org.eventb.core.target="C0"/>
    <org.eventb.core.seesContext name="_blkVEGAuEfGStvY_HyjkDQ" org.eventb.core.target="C0Ctx"/>
    <org.eventb.core.event name="'" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.generated="false" org.eventb.core.label="INITIALISATION">
        <org.eventb.core.action name="_vIR8IGDxEfGEWvuFI08lww" org.eventb.core.assignment="a ≔ 0" org.eventb.core.generated="false" org.eventb.core.label="a0"/>
        <org.eventb.core.action name="_vIR8IWDxEfGEWvuFI08lww" org.eventb.core.assignment="b ≔ 0" org.eventb.core.generated="false" org.eventb.core.label="a1"/>
        <org.eventb.core.action name="_vIR8ImDxEfGEWvuFI08lww" org.eventb.core.assignment="c ≔ 0" org.eventb.core.generated="false" org.eventb.core.label="a2"/>
    </org.eventb.core.event>
    <org.eventb.core.variable name="_blkVFGAuEfGStvY_HyjkDQ" org.eventb.core.comment="Number of cars on the bridge going to the island." org.eventb.core.generated="false" org.eventb.core.identifier="a"/>
    <org.eventb.core.variable name="_blkVFWAuEfGStvY_HyjkDQ" org.eventb.core.comment="Number of cars on the island." org.eventb.core.generated="false" org.eventb.core.identifier="b"/>
    <org.eventb.core.variable name="_blkVFmAuEfGStvY_HyjkDQ" org.eventb.core.comment="Number of cars on the bridge going to the mainland." org.eventb.core.generated="false" org.eventb.core.identifier="c"/>
    <org.eventb.core.event name="_blk8ImAuEfGStvY_HyjkDQ" org.eventb.core.comment="One car on the bridge enters the mainland." org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.generated="false" org.eventb.core.label="ML_in">
        <org.eventb.core.refinesEvent name="_blk8I2AuEfGStvY_HyjkDQ" org.eventb.core.target="ML_in"/>
        <org.eventb.core.guard name="_vISjMGDxEfGEWvuFI08lww" org.eventb.core.generated="false" org.eventb.core.label="g0" org.eventb.core.predicate="c &gt; 0"/>
        <org.eventb.core.action name="_vISjMWDxEfGEWvuFI08lww" org.eventb.core.assignment="c ≔ c−1" org.eventb.core.generated="false" org.eventb.core.label="a0"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="_blk8JmAuEfGStvY_HyjkDQ" org.eventb.core.comment="One car from the mainland enters the bridge." org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.generated="false" org.eventb.core.label="ML_out">
        <org.eventb.core.refinesEvent name="_blljMGAuEfGStvY_HyjkDQ" org.eventb.core.target="ML_out"/>
        <org.eventb.core.guard name="_vISjMmDxEfGEWvuFI08lww" org.eventb.core.comment="Max cars not reached on island + bridge." org.eventb.core.generated="false" org.eventb.core.label="g0" org.eventb.core.predicate="a+b+c &lt; d"/>
        <org.eventb.core.guard name="_vISjM2DxEfGEWvuFI08lww" org.eventb.core.comment="No car on the bridge going to the mainland." org.eventb.core.generated="false" org.eventb.core.label="g1" org.eventb.core.predicate="c = 0"/>
        <org.eventb.core.action name="_vISjNGDxEfGEWvuFI08lww" org.eventb.core.assignment="a ≔ a+1" org.eventb.core.generated="false" org.eventb.core.label="a0"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="_blljNGAuEfGStvY_HyjkDQ" org.eventb.core.comment="One car on the bridge enters the island.&#10;     No car count check here because it is done when leaving the mainland.&#10;     variant' = 2(a-1) + (b+1)&#10;     = (2a + -2) + (b+1)&#10;     = 2a + b - 1&#10;     &lt; 2a + b " org.eventb.core.convergence="1" org.eventb.core.extended="false" org.eventb.core.generated="false" org.eventb.core.label="IL_in">
        <org.eventb.core.guard name="_vISjNWDxEfGEWvuFI08lww" org.eventb.core.comment="At least one incoming car on the bridge." org.eventb.core.generated="false" org.eventb.core.label="g0" org.eventb.core.predicate="a &gt; 0"/>
        <org.eventb.core.action name="_vISjNmDxEfGEWvuFI08lww" org.eventb.core.assignment="a ≔ a−1" org.eventb.core.generated="false" org.eventb.core.label="a0"/>
        <org.eventb.core.action name="_vISjN2DxEfGEWvuFI08lww" org.eventb.core.assignment="b ≔ b+1" org.eventb.core.generated="false" org.eventb.core.label="a1"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="_blljOGAuEfGStvY_HyjkDQ" org.eventb.core.comment="One car on the island enters the bridge.&#10;     variant' = 2a + b-1&#10;     &lt; 2a + b " org.eventb.core.convergence="1" org.eventb.core.extended="false" org.eventb.core.generated="false" org.eventb.core.label="IL_out">
        <org.eventb.core.guard name="_vISjOGDxEfGEWvuFI08lww" org.eventb.core.comment="No incoming car on the bridge." org.eventb.core.generated="false" org.eventb.core.label="g0" org.eventb.core.predicate="a = 0"/>
        <org.eventb.core.guard name="_vISjOWDxEfGEWvuFI08lww" org.eventb.core.comment="Some cars on the island." org.eventb.core.generated="false" org.eventb.core.label="g1" org.eventb.core.predicate="b &gt; 0"/>
        <org.eventb.core.action name="_vISjOmDxEfGEWvuFI08lww" org.eventb.core.assignment="b ≔ b−1" org.eventb.core.generated="false" org.eventb.core.label="a0"/>
        <org.eventb.core.action name="_vISjO2DxEfGEWvuFI08lww" org.eventb.core.assignment="c ≔ c+1" org.eventb.core.generated="false" org.eventb.core.label="a1"/>
    </org.eventb.core.event>
    <org.eventb.core.invariant name="_vISjPGDxEfGEWvuFI08lww" org.eventb.core.generated="false" org.eventb.core.label="i0" org.eventb.core.predicate="a ∈ ℕ"/>
    <org.eventb.core.invariant name="_vITKQGDxEfGEWvuFI08lww" org.eventb.core.generated="false" org.eventb.core.label="i1" org.eventb.core.predicate="b ∈ ℕ"/>
    <org.eventb.core.invariant name="_vITKQWDxEfGEWvuFI08lww" org.eventb.core.generated="false" org.eventb.core.label="i2" org.eventb.core.predicate="c ∈ ℕ"/>
    <org.eventb.core.invariant name="_vITKQmDxEfGEWvuFI08lww" org.eventb.core.generated="false" org.eventb.core.label="i3" org.eventb.core.predicate="n = a+b+c"/>
    <org.eventb.core.invariant name="_vITKQ2DxEfGEWvuFI08lww" org.eventb.core.comment="One-way bridge.&#10;     From C0:&#10;     a+b+c ≤ d&#10;     a+b+c &gt; 0 ∨ a+b+c &lt; d " org.eventb.core.generated="false" org.eventb.core.label="i4" org.eventb.core.predicate="a = 0 ∨ c = 0"/>
    <org.eventb.core.invariant name="_6ZLB0WBSEfG8qrHV6ccKWg" org.eventb.core.comment="Disjunction of all event guards.&#10;   * `(n &gt; 0 ∨ n &lt; d) ⇒ ` is removed because it is already proved in&#10;   * the first model (C0).&#10;   * Informal proof:&#10;   * - We know the bridge is one-way (a = 0 ∨ c = 0).&#10;   * - Suppose no car on the bridge to the island (a = 0).&#10;   *   - Suppose cars on the island (b &gt; 0) -&gt; IL_out possible.&#10;   *   - Suppose no car on the island (b = 0).&#10;   *     - Suppose cars on bridge to the mainland (c &gt; 0) -&gt; ML_in possible.&#10;   *     - Suppose no car on bridge to the mainland (c = 0) -&gt; ML_out possible.&#10;   * - Suppose no car on the bridge to the mainland (c = 0).&#10;   *   - Suppose cars on bridge to island (a &gt; 0) -&gt; IL_in possible&#10;   *   - Suppose no car on bridge to island (a = 0).&#10;   *     - Suppose cars on island (b &gt; 0) -&gt; IL_out possible&#10;   *     - Suppose no car on island (b = 0) -&gt; ML_out possible " org.eventb.core.generated="false" org.eventb.core.label="dlf" org.eventb.core.predicate="(c &gt; 0)&#10;               ∨ (a+b+c &lt; d ∧ c = 0)&#10;               ∨ (a &gt; 0)&#10;               ∨ (a = 0 ∧ b &gt; 0)" org.eventb.core.theorem="true"/>
    <org.eventb.core.variant name="_8CizYGBSEfG8qrHV6ccKWg" org.eventb.core.expression="2∗a + b" org.eventb.core.generated="false" org.eventb.emf.persistence.variant_label="vrn"/>
</org.eventb.core.machineFile>

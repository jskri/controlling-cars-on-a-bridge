<org.eventb.core.machineFile org.eventb.core.comment="*************************************************************************&#10; * Third model of course 02: Controlling cars on a bridge&#10; *&#10; * Introducing traffic lights.&#10; *&#10; * See https://web-archive.southampton.ac.uk/deploy-eprints.ecs.soton.ac.uk/112/1/sld.ch2.car.pdf&#10; *&#10; *              IL_in                       ML_out&#10; *  ---------   &lt;-----   ----------------   &lt;-----   ----------&#10; * | Island  |          | One Way Bridge |          | MainLand |&#10; *  ---------   -----&gt;   ----------------   -----&gt;   ----------&#10; *              IL_out                       ML_in&#10; *                              a               ml_tl&#10; *  ---------   &lt;---------------------------------   ----------&#10; * |    b    |            One Way Bridge            |          |&#10; *  ---------   ---------------------------------&gt;   ----------&#10; *           il_tl              c&#10; * ************************************************************************* " org.eventb.core.configuration="org.eventb.core.fwd" org.eventb.core.generated="false" org.eventb.texttools.text_lastmodified="1780688571750" org.eventb.texttools.text_representation="machine C2&#10;/* *************************************************************************&#10; * Third model of course 02: Controlling cars on a bridge&#10; *&#10; * Introducing traffic lights.&#10; *&#10; * See https://web-archive.southampton.ac.uk/deploy-eprints.ecs.soton.ac.uk/112/1/sld.ch2.car.pdf&#10; *&#10; *              IL_in                       ML_out&#10; *  ---------   &lt;-----   ----------------   &lt;-----   ----------&#10; * | Island  |          | One Way Bridge |          | MainLand |&#10; *  ---------   -----&gt;   ----------------   -----&gt;   ----------&#10; *              IL_out                       ML_in&#10; *                              a               ml_tl&#10; *  ---------   &lt;---------------------------------   ----------&#10; * |    b    |            One Way Bridge            |          |&#10; *  ---------   ---------------------------------&gt;   ----------&#10; *           il_tl              c&#10; * ************************************************************************* */&#10; refines C1  sees C2Ctx&#10;&#10;variables a // Number of cars on the bridge going to the island.&#10;          b // Number of cars on the island.&#10;          c // Number of cars on the bridge going to the mainland.&#10;          ml_tl // Mainland's traffic light.&#10;          il_tl // Island's traffic light.&#10;          ml_pass // True if at least one car passed since ml tl turned green.&#10;          il_pass // True if at least one car passed since il tl turned green.&#10;&#10;&#10;invariants&#10;  @i0 ml_tl ∈ COLOR&#10;  @i1 il_tl ∈ COLOR&#10;  @i2 ml_pass ∈ BOOL&#10;  @i3 il_pass ∈ BOOL&#10;  @i4 ml_tl = green ⇒ a+b &lt; d ∧ c = 0 // Green implies the guard of C1.ML_out&#10;  @i5 il_tl = green ⇒ b &gt; 0 ∧ a = 0 // Green implies the guard of C1.IL_out.&#10;  @i6 ml_tl = red ∨ il_tl = red // At least one traffic light is red.&#10;  @i7 ml_tl = red ⇒ ml_pass = TRUE&#10;  @i8 il_tl = red ⇒ il_pass = TRUE&#10;  /* From C0:&#10;     a+b+c ≤ d&#10;     a+b+c &gt; 0 ∨ a+b+c &lt; d&#10;     From C1:&#10;     n = a+b+c&#10;     a = 0 ∨ c = 0 // one-way bridge&#10;     (c &gt; 0) ∨ (a+b+c &lt; d ∧ c = 0) ∨ (a &gt; 0) ∨ (a = 0 ∧ b &gt; 0) // deadlock-free */&#10;  theorem @dlf (ml_tl = red ∧ a+b &lt; d ∧ c = 0 ∧ il_pass = TRUE)&#10;               ∨ (il_tl = red ∧ 0 &lt; b ∧ a = 0 ∧ ml_pass = TRUE)&#10;               ∨ c &gt; 0&#10;               ∨ ml_tl = green&#10;               ∨ a &gt; 0&#10;               ∨ il_tl = green&#10;  /* Disjunction of all event guards.&#10;   * Informal proof:&#10;   * - We know the bridge is one-way (a = 0 ∨ c = 0).&#10;   * - Suppose no car on the bridge to the island (a = 0).&#10;   *   - Suppose cars on the island (b &gt; 0).&#10;   *     - Suppose not last car on the island (b &gt; 1) -&gt; IL_out_1 possible.&#10;   *     - Suppose last car on the island (b = 1) -&gt; IL_out_2 possible.&#10;   *   - Suppose no car on the island (b = 0).&#10;   *     - Suppose cars on bridge to the mainland (c &gt; 0) -&gt; ML_in possible.&#10;   *     - Suppose no car on bridge to the mainland (c = 0).&#10;   *       - Suppose more than one car can enter island+bridge (a+b+1 &lt; d) -&gt;&#10;   *           ML_out_1 possible&#10;   *       - Suppose this is the last car that can enter island+bridge (a+b+1 = d) -&gt;&#10;   *           ML_out_2 possible&#10;   * - Suppose no car on the bridge to the mainland (c = 0).&#10;   *   - Suppose cars on bridge to island (a &gt; 0) -&gt; IL_in possible&#10;   *   - Suppose no car on bridge to island (a = 0).&#10;   *     - Suppose cars on island (b &gt; 0).&#10;   *       - Suppose more than one car still on the island (b−1 &gt; 0) -&gt;&#10;   *           IL_out_1 possible&#10;   *       - Suppose this is the last car on the island (b−1 = 0) -&gt;&#10;   *           IL_out_2 possible&#10;   *     - Suppose no car on island (b = 0).&#10;   *       - Suppose more than one car can enter island+bridge (a+b+1 &lt; d) -&gt;&#10;   *           ML_out_1 possible&#10;   *     - Suppose this is the last car that can enter island+bridge (a+b+1 = d) -&gt;&#10;   *           ML_out_2 possible */&#10;&#10;variant b2n(ml_pass) + b2n(il_pass)&#10;&#10;events&#10;  event INITIALISATION extends INITIALISATION&#10;    then&#10;      @a3 il_tl   ≔ red&#10;      @a4 ml_tl   ≔ red&#10;      @a5 ml_pass ≔ TRUE&#10;      @a6 il_pass ≔ TRUE&#10;  end&#10;&#10;  convergent event ML_tl_green // Mainland's traffic light turns green.&#10;    where&#10;      @g0 ml_tl = red&#10;      @g1 a+b &lt; d&#10;      @g2 c = 0&#10;      @g3 il_pass = TRUE&#10;    then&#10;      @a0 ml_tl   ≔ green&#10;      @a1 il_tl   ≔ red&#10;      @a2 ml_pass ≔ FALSE&#10;  end&#10;&#10;  convergent event IL_tl_green // Island's traffic light turns green.&#10;    where&#10;      @g0 il_tl = red&#10;      @g1 a = 0&#10;      @g2 b &gt; 0&#10;      @g3 ml_pass = TRUE&#10;    then&#10;      @a0 ml_tl   ≔ red&#10;      @a1 il_tl   ≔ green&#10;      @a2 il_pass ≔ FALSE&#10;  end&#10;&#10;  event ML_in // One car on the bridge enters the mainland (idem C1).&#10;  extends ML_in&#10;  end&#10;&#10;  event ML_out_1&#10;  /* One car from the mainland enters the bridge.&#10;     The mainland's traffic light stays green. */&#10;  refines ML_out&#10;    where&#10;      @g0 ml_tl = green&#10;      @g1 a+b+1 &lt; d&#10;    then&#10;      @a0 a       ≔ a+1&#10;      @a1 il_tl   ≔ red&#10;      @a2 ml_pass ≔ TRUE&#10;  end&#10;&#10;  event ML_out_2&#10;  /* One car from the mainland enters the bridge.&#10;     The mainland's traffic light turns red. */&#10;  refines ML_out&#10;    where&#10;      @g0 ml_tl = green&#10;      @g1 a+b+1 = d&#10;    then&#10;      @a0 a       ≔ a+1&#10;      @a1 il_tl   ≔ red&#10;      @a2 ml_tl   ≔ red&#10;      @a3 ml_pass ≔ TRUE&#10;  end&#10;&#10;  event IL_in // // One car on the bridge enters the island (idem C1).&#10;  extends IL_in&#10;  end&#10;&#10;  event IL_out_1&#10;  /* One car on the island enters the bridge.&#10;     The island's traffic light stays green. */&#10;  refines IL_out&#10;    where&#10;      @g0 il_tl = green&#10;      @g1 b &gt; 1&#10;    then&#10;      @a0 b       ≔ b−1&#10;      @a1 c       ≔ c+1&#10;      @a2 ml_tl   ≔ red&#10;      @a3 il_tl   ≔ green&#10;      @a4 il_pass ≔ TRUE&#10;  end&#10;&#10;  event IL_out_2&#10;  /* One car on the island enters the bridge.&#10;     The island's traffic light turns red. */&#10;  refines IL_out&#10;    where&#10;      @g0 il_tl = green&#10;      @g1 b = 1&#10;    then&#10;      @a0 b       ≔ b−1&#10;      @a1 c       ≔ c+1&#10;      @a2 ml_tl   ≔ red&#10;      @a3 il_tl   ≔ red&#10;      @a4 il_pass ≔ TRUE&#10;  end&#10;end&#10;" version="5">

    <org.eventb.core.invariant name="_OxD9MmDxEfGEWvuFI08lww" org.eventb.core.comment="From C0:&#10;     a+b+c ≤ d&#10;     a+b+c &gt; 0 ∨ a+b+c &lt; d&#10;     From C1:&#10;     n = a+b+c&#10;     a = 0 ∨ c = 0 // one-way bridge&#10;     (c &gt; 0) ∨ (a+b+c &lt; d ∧ c = 0) ∨ (a &gt; 0) ∨ (a = 0 ∧ b &gt; 0) // deadlock-free " org.eventb.core.generated="false" org.eventb.core.label="i8" org.eventb.core.predicate="il_tl = red ⇒ il_pass = TRUE"/>
    <org.eventb.core.invariant name="_GVh7IGDMEfGzcLFmylS19g" org.eventb.core.comment="Disjunction of all event guards.&#10;   * Informal proof:&#10;   * - We know the bridge is one-way (a = 0 ∨ c = 0).&#10;   * - Suppose no car on the bridge to the island (a = 0).&#10;   *   - Suppose cars on the island (b &gt; 0).&#10;   *     - Suppose not last car on the island (b &gt; 1) -&gt; IL_out_1 possible.&#10;   *     - Suppose last car on the island (b = 1) -&gt; IL_out_2 possible.&#10;   *   - Suppose no car on the island (b = 0).&#10;   *     - Suppose cars on bridge to the mainland (c &gt; 0) -&gt; ML_in possible.&#10;   *     - Suppose no car on bridge to the mainland (c = 0).&#10;   *       - Suppose more than one car can enter island+bridge (a+b+1 &lt; d) -&gt;&#10;   *           ML_out_1 possible&#10;   *       - Suppose this is the last car that can enter island+bridge (a+b+1 = d) -&gt;&#10;   *           ML_out_2 possible&#10;   * - Suppose no car on the bridge to the mainland (c = 0).&#10;   *   - Suppose cars on bridge to island (a &gt; 0) -&gt; IL_in possible&#10;   *   - Suppose no car on bridge to island (a = 0).&#10;   *     - Suppose cars on island (b &gt; 0).&#10;   *       - Suppose more than one car still on the island (b−1 &gt; 0) -&gt;&#10;   *           IL_out_1 possible&#10;   *       - Suppose this is the last car on the island (b−1 = 0) -&gt;&#10;   *           IL_out_2 possible&#10;   *     - Suppose no car on island (b = 0).&#10;   *       - Suppose more than one car can enter island+bridge (a+b+1 &lt; d) -&gt;&#10;   *           ML_out_1 possible&#10;   *     - Suppose this is the last car that can enter island+bridge (a+b+1 = d) -&gt;&#10;   *           ML_out_2 possible " org.eventb.core.generated="false" org.eventb.core.label="dlf" org.eventb.core.predicate="(ml_tl = red ∧ a+b &lt; d ∧ c = 0 ∧ il_pass = TRUE)&#10;               ∨ (il_tl = red ∧ 0 &lt; b ∧ a = 0 ∧ ml_pass = TRUE)&#10;               ∨ c &gt; 0&#10;               ∨ ml_tl = green&#10;               ∨ a &gt; 0&#10;               ∨ il_tl = green" org.eventb.core.theorem="true"/>
